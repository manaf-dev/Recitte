# Copy to .env.local (never commit it). Local values are printed by `pnpm db:start`;
# production values come from the Supabase dashboard (Project Settings > API Keys: the publishable key, sb_publishable_…).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: the public site's origin. When set, the header shows a "View site" link.
VITE_PUBLIC_SITE_URL=
