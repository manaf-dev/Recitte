# Public values only: both end up in the browser. Use the publishable key
# (sb_publishable_…), never a secret key.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin for share links and Open Graph URLs, e.g. https://recitte.org
NUXT_PUBLIC_SITE_URL=
