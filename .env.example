# Copy to .env (never commit it). Values for the local stack are printed by
# `pnpm db:start`; production values come from the Supabase dashboard
# (Project Settings > API Keys). The legacy anon/service_role keys are being
# retired; use the publishable and secret keys.

# Supabase project
SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe (sb_publishable_…): goes to both apps.
SUPABASE_PUBLISHABLE_KEY=
# Server only (sb_secret_…). Edge Functions get it injected as
# SUPABASE_SECRET_KEYS; never put it in a browser app.
SUPABASE_SECRET_KEY=

# Origins of the two apps (used for invite redirects and canonical links)
ADMIN_URL=http://127.0.0.1:5174
PUBLIC_SITE_URL=http://127.0.0.1:3000

# Submission emails (optional). Without both, submissions are still saved and
# no email is sent.
RESEND_API_KEY=
RESEND_FROM=
