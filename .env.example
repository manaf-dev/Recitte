# Copy to .env (never commit it). Values for the local stack are printed by
# `pnpm db:start`; production values come from the Supabase dashboard.

# Supabase project
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server only: Edge Functions and scripts. Never put this in a browser app.
SUPABASE_SERVICE_ROLE_KEY=

# Origins of the two apps (used for invite redirects and canonical links)
ADMIN_URL=http://127.0.0.1:5174
PUBLIC_SITE_URL=http://127.0.0.1:3000

# Submission emails (optional). Without both, submissions are still saved and
# no email is sent.
RESEND_API_KEY=
RESEND_FROM=
