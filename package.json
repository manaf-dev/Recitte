{
  "name": "recitte",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "pnpm -r --if-present test && pnpm test:functions",
    "test:functions": "vitest run --root supabase/functions",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p supabase/functions/tsconfig.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
